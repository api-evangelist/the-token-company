          "name": "Compress a chat conversation",
          "request": {
            "name": "Compress a chat conversation",
            "description": {
              "content": "Compress a whole OpenAI- or Anthropic-format message array in a single request. Assistant messages pass through unchanged so the downstream provider's KV cache stays warm; re-sent history is served from a server-side cache.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "chat",
                "compress"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    \"<object>\",\n    \"<object>\"\n  ],\n  \"model\": \"bear-2\",\n  \"fmt\": \"openai\",\n  \"aggressiveness\": \"<float>\",\n  \"system\": {},\n  \"strip_server_tool_results\": false,\n  \"skip_tool_use_ids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"app_id\": \"<string>\"\n}",
